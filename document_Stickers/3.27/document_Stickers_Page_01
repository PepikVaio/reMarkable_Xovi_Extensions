    // Hotovo
    Timer {
        id: timer_Delay
        interval: 1000
        repeat: false
        property var pending_Models: []

        function schedule(model) {
            if (pending_Models.indexOf(model) === -1) {
                pending_Models.push(model)
            }
            restart()
        }

        onTriggered: {
            for (var i = 0; i < pending_Models.length; i++) {
                page.refresh_Data(pending_Models[i])
            }
            pending_Models = []
        }
    }

    // Hotovo
function refresh_Data(model) {
    var data = root_Stickers.create_Folder_Data(model)
    var files_Sorted = sortProperties.sortModel(data.files, sortProperties.ascending)
    page.pages = page.create_Pages(data.folders, files_Sorted)
    page.navigate_To_Page(0)
}

    // Hotovo
    function create_Pages(folders, files) {
        var columns = page.items_Per_Row
        var height_Available = Math.max(1, scrollingArea.height)
        var height_Row_Folder = Values.navigatorContentCollectionHeight
        var height_Row_File = page.get_Item_Height()
        var index_Folder = 0
        var index_File = 0
        var result = []

        while (index_Folder < folders.length || index_File < files.length) {
            var page_Folders = []
            var page_Files = []
            var height_Use = 0

            while (index_Folder < folders.length && page.check_Row_Space(height_Use, height_Row_Folder, page_Folders.length + page_Files.length, height_Available)) {
                var count_Row_Folder = Math.min(columns, folders.length - index_Folder)
                for (var f = 0; f < count_Row_Folder; f++) {
                    page_Folders.push(folders[index_Folder++])
                }
                height_Use += height_Row_Folder
            }

            while (index_File < files.length && page.check_Row_Space(height_Use, height_Row_File, page_Folders.length + page_Files.length, height_Available)) {
                var count_Row_File = Math.min(columns, files.length - index_File)
                for (var n = 0; n < count_Row_File; n++) {
                    page_Files.push(files[index_File++])
                }
                while (count_Row_File < columns) {
                    page_Files.push({ is_Spacer: true, fileName: "", fileUrl: "" })
                    count_Row_File++
                }
                height_Use += height_Row_File
            }

            result.push({ folders: page_Folders, files: page_Files })
        }

        if (result.length === 0) {
            result.push({ folders: [], files: [] })
        }

        return result
    }

    // Hotovo
    function create_Navigation(url_Folder) {
        // var is_Favorite = url_Folder === Qt.resolvedUrl(root_Stickers.path_Favorite)
        var is_Favorite = String(url_Folder).startsWith(String(Qt.resolvedUrl(root_Stickers.path_Favorite)))
        var path_Current = String(url_Folder)
        var path_Root = is_Favorite ? root_Stickers.path_Favorite : root_Stickers.path_Stickers
        var path_Navigation = [{ name: is_Favorite ? qsTr("Favorite") : qsTr("All"), id: path_Root }]

        var path_Relative = path_Current.slice(path_Root.length)
        if (path_Relative.charAt(0) === "/") {
            path_Relative = path_Relative.slice(1)
        }

        if (path_Relative.length === 0) {
            return path_Navigation
        }

        var path_Relative_Split = path_Relative.split("/")
        for (var i = 0; i < path_Relative_Split.length; i++) {
            if (!path_Relative_Split[i]) continue

            path_Root += "/" + path_Relative_Split[i]
            path_Navigation.push({
                name: decodeURIComponent(path_Relative_Split[i]),
                id: path_Root
            })
        }

        return path_Navigation
    }

    // Hotovo
    function check_Row_Space(height_Use, height_Row, count_Item, height_Available) {
        return height_Use + height_Row <= height_Available || count_Item === 0
    }

    // Hotovo - Přidat promennou na změnu velikosti items
    function get_Item_Height() {
        return page.list_Mode ? Values.navigatorContentListItemHeight + Values.navigatorMargin : thumbnailGridSize.gridItemHeight
    }

    // Hotovo
    function navigate_To_Page(index) {
        var index_Next = Math.max(0, Math.min(index, page.pages.length - 1))
        page._currentPageIndex = index_Next

        if (myStickersContent.width > 0) {
            myStickersContent.contentX = index_Next * scrollingArea.horizontalStepSize
        }
    }
