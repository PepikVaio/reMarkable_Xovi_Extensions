AFFECT /qml/device/view/documentview/DeviceSceneView.qml

    TRAVERSE FocusScope#root > Timer#viewportUpdateTimer

        REPLACE interval WITH {
            interval: Values.settings_Screen_Mode.set_Delay_Refresh
        }

END AFFECT

AFFECT /qt/qml/xofm/modules/wifi/qml/WifiInfo.qml

    TRAVERSE Item#root 

        REPLACE implicitHeight WITH {
            implicitHeight: Values.settings_Screen_Mode.is_Enabled_Screen_Mode && Values.settings_Screen_Mode.is_Enabled_Quick_Settings
                ? ArkTokens.Style.variable.controlsHeight.large
                // Original form reMarkable
                : (visible ? ArkTokens.Style.variable.controlsHeight.small : 0)
        }

        LOCATE AFTER RowLayout#wifiRow
        INSERT {
            RowLayout {
                spacing: ArkTokens.Style.variable.platform.spacing.small
                width: parent.width
                visible: Values.settings_Screen_Mode.is_Enabled_Screen_Mode && Values.settings_Screen_Mode.is_Enabled_Quick_Settings
                anchors.top: wifiRow.bottom
                anchors.topMargin: 6

                ArkControls.Label {
                    accessibility: false
                    Layout.alignment: Qt.AlignVCenter | Qt.AlignLeft
                    text: qsTr("Ref. mode: ") + Values.settings_Screen_Mode.set_Active_Text + ((Values.settings_Screen_Mode.set_Active_Mode === "Mono" || Values.settings_Screen_Mode.set_Active_Mode === "Animation") ? "*" : "")
                    elide: Text.ElideMiddle
                    Layout.fillWidth: true
                }
            }
        }

        REPLACE MouseArea WITH {
            MouseArea {
                // Enabled just for wifiRow
                anchors.fill: Values.settings_Screen_Mode.is_Enabled_Screen_Mode && Values.settings_Screen_Mode.is_Enabled_Quick_Settings
                ? wifiRow
                // Original form reMarkable
                : root

                // Original from reMarkable
                onClicked: {
                    root.windowNavigator.open("settings/window/main", { index: SettingsPage.Wifi });
                    root.windowNavigator.close("settings/window/quicksettings");
                }
            }
        }

END AFFECT
